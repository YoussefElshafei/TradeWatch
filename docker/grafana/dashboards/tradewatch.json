        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, state) (tradewatch_db_pool_connections{state=~\"checked_out|idle|overflow\"})",
          "legendFormat": "{{job}} {{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
