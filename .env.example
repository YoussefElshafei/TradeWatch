# TradeWatch environment configuration
#
# Copy to .env and adjust:      cp .env.example .env
#
# Every value below is documented in ARCHITECTURE.md section 16. Three of them have no
# default and the application refuses to start without them; everything else is optional
# and shown here with its default so there is one place to see what is tunable.
#
# The TW_ variables configure the backend. The VITE_ variables at the bottom configure the
# frontend — Vite only exposes VITE_-prefixed values to browser code, which is why a
# backend secret cannot leak into the bundle by accident.
#
# .env is git-ignored. Never commit real credentials.


# =============================================================================
# REQUIRED — the application will not start without these
# =============================================================================

# PostgreSQL. No default on purpose: silently connecting to a database nobody chose is how
# test data ends up somewhere it should not be.
TW_DATABASE_URL=postgresql+asyncpg://tradewatch:tradewatch@localhost:5432/tradewatch

# Redis.
TW_REDIS_URL=redis://localhost:6379/0

# Integration tests. Optional: defaults to TW_DATABASE_URL with "_test" appended, which is
# the database docker/postgres-init creates on first start. It must never be the
# application database — the fixtures drop and recreate the public schema on every run.
# TW_TEST_DATABASE_URL=postgresql+asyncpg://tradewatch:tradewatch@localhost:5432/tradewatch_test

# JWT signing key. A signing key with a default is a signing key that ships to production.
# Generate one:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# With TW_ENV=prod this must be at least 32 characters and not a placeholder.
TW_JWT_SECRET=dev-only-replace-me-with-a-generated-value


# =============================================================================
# Application (section 16.9)
# =============================================================================
TW_ENV=local                       # local | ci | prod
TW_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
TW_LOG_FORMAT=console              # console | json   (prod requires json)
TW_METRICS_ENABLED=true            # each process serves Prometheus /metrics on its own port
TW_METRICS_HOST=127.0.0.1          # 0.0.0.0 only if Prometheus scrapes from another host
# TW_METRICS_PORT=                 # per-process override; defaults: api 9310, producer 9311,
#                                  # consumer 9312, aggregator 9313, broadcaster 9314,
#                                  # backtest-runner 9315, paper-trading 9316,
#                                  # anomaly-detector 9317, alert-dispatcher 9318


# =============================================================================
# API surface (section 16.9)
# =============================================================================
# Loopback by default. There is no authentication until Phase 5, so the API must not be
# reachable from the network by accident before then.
TW_API_HOST=127.0.0.1
# 8010, not 8000: a stale process from an earlier dev session can permanently squat on 8000
# with no reliable way to identify or kill it (see docs/PROJECT_STATE.md's known issues).
TW_API_PORT=8010
TW_API_PAGE_SIZE_DEFAULT=100
TW_API_PAGE_SIZE_MAX=1000
TW_BACKTEST_TIMEOUT_SECONDS=300
TW_WS_MAX_CONNECTIONS_PER_USER=5
TW_WS_SEND_BUFFER_LIMIT=1000


# =============================================================================
# Market and instruments (section 16.1)
# =============================================================================
TW_SYMBOLS=AAPL,MSFT,NVDA,SPY
TW_MARKET_TIMEZONE=America/New_York
TW_MARKET_SESSION_OPEN=09:30
TW_MARKET_SESSION_CLOSE=16:00
TW_BASE_CURRENCY=USD
TW_BAR_INTERVALS=1m,5m,1h,1d
# How long after a bar closes a late trade may still revise it (failure F11).
# Past this the bar is sealed and a straggler is counted and dropped: a bar that can
# be revised forever is a bar nothing downstream can ever act on.
TW_LATE_DATA_GRACE_SECONDS=5

# How often the aggregator derives 5m/1h/1d bars from the stored 1m bars, and how far
# back each pass reaches. The lookback must comfortably exceed the largest interval in
# TW_BAR_INTERVALS, or the current daily bar is never recomputed as minutes arrive.
TW_ROLLUP_INTERVAL_SECONDS=60
TW_ROLLUP_LOOKBACK_MINUTES=2880


# =============================================================================
# Market data provider (section 16.2, ADR-0004)
# =============================================================================
# synthetic | replay | alpaca. Anything else fails at startup rather than at the first
# tick, because a provider name without an adapter is a promise nothing can keep.
#
#   synthetic  seeded generator; no key, no network, no quota, deterministic. The default.
#   replay     playback of a recorded JSONL session; needs TW_REPLAY_PATH.
#   alpaca     Alpaca Market Data API v2 (ADR-0011); needs the key pair below.
TW_PROVIDER=synthetic
TW_SYNTHETIC_SEED=42
# TW_REPLAY_PATH=tests/fixtures/session.jsonl

# Alpaca issues a key *pair*; a key alone will not authenticate. Startup refuses
# TW_PROVIDER=alpaca without both, rather than failing on the first request.
# TW_PROVIDER_API_KEY=
# TW_PROVIDER_API_SECRET=
# TW_PROVIDER_BASE_URL=

TW_PROVIDER_RATE_LIMIT_PER_MIN=60
TW_PROVIDER_TIMEOUT_S=10
TW_PROVIDER_RECONNECT_MAX_BACKOFF_S=30
TW_PROVIDER_STALENESS_THRESHOLD_S=30
# 0 means reconnect forever, which is what a market data feed wants: giving up at 04:00
# because the provider blipped is not better than reconnecting at 04:01.
TW_PROVIDER_MAX_RECONNECT_ATTEMPTS=0

# In-flight duplicate window. The database's UNIQUE(event_id) is the real guarantee
# (ADR-0012); this only saves the round trip, so it is bounded and forgets.
TW_DEDUPE_WINDOW_SECONDS=900
TW_DEDUPE_MAX_ENTRIES=100000


# =============================================================================
# Kafka (section 16.3, ADR-0001) — the event backbone, used from Phase 2
# =============================================================================
# The broker. From inside the Compose network this is `kafka:19092`; from the host it is
# `localhost:9092`. They are two listeners on one broker, and using the wrong one gives a
# client that connects, fetches metadata, and then times out talking to an address it
# cannot reach.
TW_KAFKA_BOOTSTRAP=localhost:9092

# Topic namespace. Everything after the prefix is a contract (ARCHITECTURE.md §7.2):
#   <prefix>.market.trades.v1   <prefix>.market.quotes.v1
#   <prefix>.market.bars.1m.v1  <prefix>.dlq.v1
# Two environments can share a broker by using different prefixes.
TW_KAFKA_TOPIC_PREFIX=tw

# Partitions per market topic. Ordering is guaranteed per partition and the key is the
# symbol, so this is the ceiling on consumer parallelism and never a risk to per-symbol
# ordering. Changing it later repartitions the keyspace.
TW_KAFKA_TOPIC_PARTITIONS=6
# One broker locally means nothing can be replicated. Raise both in production.
TW_KAFKA_TOPIC_REPLICATION=1
# Create missing topics at worker startup. Right for local and CI; production creates
# topics deliberately and sets this to false.
TW_KAFKA_ENSURE_TOPICS=true

# --- producer ---
# "all" means every in-sync replica acknowledged. Idempotence stops the producer's own
# retries becoming duplicates, and requires acks=all. Neither makes the pipeline
# exactly-once — see ARCHITECTURE.md §7.4.
TW_KAFKA_PRODUCER_ACKS=all
TW_KAFKA_PRODUCER_IDEMPOTENCE=true
TW_KAFKA_PRODUCER_LINGER_MS=5
# gzip or none. The other codecs need a package that is not installed, so they are
# refused at startup rather than at the first produce.
TW_KAFKA_PRODUCER_COMPRESSION=gzip
TW_KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=30000
TW_KAFKA_PRODUCER_MAX_ATTEMPTS=3

# --- consumer ---
# One group per logical consumer (§7.4). A second consumer of the same topics gets its
# own group, and therefore its own offsets.
TW_KAFKA_CONSUMER_GROUP=processor-persist
# The bar aggregator's group. Separate on purpose: separate groups mean separate
# offsets and separate failure domains, which is the whole argument for Kafka
# (ADR-0001). Sharing one would make the two services compete for partitions and
# each would see only half the trades.
TW_KAFKA_AGGREGATOR_GROUP=bar-aggregator
# The broadcaster's group (Phase 4). A third independent reader of the same topics, fanning
# out to WebSocket clients via Redis Pub/Sub — its own offsets, same reasoning as above.
TW_KAFKA_BROADCAST_GROUP=broadcaster
# Where a brand-new group starts. "earliest" so a consumer added to an existing topic
# processes the history instead of silently skipping it.
TW_KAFKA_AUTO_OFFSET_RESET=earliest
TW_KAFKA_CONSUMER_POLL_TIMEOUT_MS=1000
TW_KAFKA_CONSUMER_SESSION_TIMEOUT_MS=45000
# Must be under a third of the session timeout, or the broker evicts the consumer under
# load and it looks like random rebalancing.
TW_KAFKA_CONSUMER_HEARTBEAT_MS=3000
TW_CONSUMER_BATCH_SIZE=100
TW_CONSUMER_MAX_POLL_INTERVAL_MS=300000
# Bounded retries for a *retryable* failure — a database that is down. A permanent failure
# is never retried; it goes to the dead-letter topic on the first attempt.
TW_CONSUMER_MAX_RETRIES=3
TW_CONSUMER_RETRY_BACKOFF_S=0.5

# With this false a permanently bad message is counted, logged and skipped instead of
# being quarantined. Nothing blocks either way; the difference is whether the message can
# be recovered afterwards.
TW_DLQ_ENABLED=true


# =============================================================================
# Storage and cache (section 16.4, ADR-0003)
# =============================================================================
TW_DATABASE_POOL_SIZE=10
TW_DATABASE_POOL_TIMEOUT_S=10
# Setting this to false must leave the application correct, only slower. That is a test.
TW_CACHE_ENABLED=true
TW_CACHE_TTL_QUOTE_S=5
TW_CACHE_TTL_BARS_S=30
TW_CACHE_TTL_INSTRUMENTS_S=3600


# =============================================================================
# Trading simulation (section 16.5) — used from Phase 6
# =============================================================================
# Slippage, commission, and the fill model change the result of every backtest. They are
# stored per run and per deployment so two results are never compared across different
# assumptions without the difference being visible.
TW_EXEC_SLIPPAGE_BPS=2
TW_EXEC_COMMISSION_PER_SHARE=0
TW_EXEC_COMMISSION_PCT=0
TW_EXEC_FILL_MODEL=next_bar_open    # next_bar_open | current_close | vwap
TW_EXEC_ALLOW_PARTIAL_FILLS=false
TW_INITIAL_CASH=100000
TW_MAX_POSITION_PCT=0.25
TW_MAX_GROSS_EXPOSURE_PCT=1.0
TW_MAX_ORDERS_PER_MINUTE_PER_DEPLOYMENT=10


# =============================================================================
# Anomaly detection (section 16.6, ADR-0008) — used from Phase 8
# =============================================================================
# These thresholds are guesses until they are calibrated against real data, which is
# precisely why they are not literals in the detector.
TW_ANOMALY_DETECTOR=baseline        # baseline | model | both
TW_ANOMALY_WINDOW_BARS=60
TW_ANOMALY_BASELINE_Z_THRESHOLD=3.5
TW_ANOMALY_MIN_BARS_BEFORE_SCORING=30
# TW_ANOMALY_MODEL_THRESHOLD=
# TW_ANOMALY_MODEL_PATH=
TW_ANOMALY_FEATURES=return,volatility,volume_z,trade_count_z,spread


# =============================================================================
# Alerts (section 16.7) — used from Phase 9
# =============================================================================
TW_ALERT_COOLDOWN_SECONDS=300
TW_ALERT_MAX_PER_USER_PER_HOUR=50
TW_ALERT_CHANNELS_ENABLED=in_app


# =============================================================================
# Security (section 16.8, ADR-0010) — enforced from Phase 5
# =============================================================================
TW_ACCESS_TOKEN_TTL_MIN=15
TW_REFRESH_TOKEN_TTL_DAYS=30
TW_PASSWORD_MIN_LENGTH=12
# Both spellings: a browser treats localhost and 127.0.0.1 as different origins, and the
# Vite dev server prints the numeric one.
TW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TW_RATE_LIMIT_ANON_PER_MIN=60
TW_RATE_LIMIT_USER_PER_MIN=600
TW_MAX_BACKTESTS_PER_USER_CONCURRENT=2
TW_MAX_DEPLOYMENTS_PER_USER=5
TW_REGISTRATION_ENABLED=true


# =============================================================================
# Frontend (Vite) — only VITE_-prefixed values reach browser code
# =============================================================================
VITE_API_BASE_URL=http://localhost:8010
VITE_ENV=local
