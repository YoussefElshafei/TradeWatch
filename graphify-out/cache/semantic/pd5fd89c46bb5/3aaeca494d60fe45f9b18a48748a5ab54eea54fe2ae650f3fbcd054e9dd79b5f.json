{"nodes": [{"id": "docker_docker_compose_postgres", "label": "postgres service", "file_type": "code", "source_file": "docker/docker-compose.yml", "source_location": "services.postgres", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initialised with --locale=C and TZ=UTC so sort order and timestamps do not depend on the host's locale; bound to loopback because it carries development credentials; postgres-init creates tradewatch_test so integration tests never run in the application database."}, {"id": "docker_docker_compose_redis", "label": "redis service", "file_type": "code", "source_file": "docker/docker-compose.yml", "source_location": "services.redis", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docker_docker_compose_kafka", "label": "kafka service (KRaft, single broker)", "file_type": "code", "source_file": "docker/docker-compose.yml", "source_location": "services.kafka", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Broker and controller in one process, no ZooKeeper. One broker is the right size for a laptop and the wrong size for anything else, which is why every replication factor is 1 and says so. The healthcheck lists topics over the host listener to prove the broker is serving the API the workers use, not merely running."}, {"id": "docker_docker_compose_api", "label": "api service (app profile)", "file_type": "code", "source_file": "docker/docker-compose.yml", "source_location": "services.api", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docker_docker_compose_postgres", "target": "backend_tests_integration_readme_integration_tests", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docker/docker-compose.yml", "source_location": "postgres-init creates tradewatch_test", "weight": 1.0}, {"source": "docker_docker_compose