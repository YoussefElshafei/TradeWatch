ed from the settings model."}, {"id": "readme_test_rules", "label": "Four Testing Rules", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every TW_ variable is stripped before each test so a test passing on one machine passes on all; warnings are errors because a DeprecationWarning is a scheduled breakage; the database is never mocked; and only tests/provider/ touches the network, deselected by default."}], "edges": [{"source": "readme_tradewatch", "target": "architecture_tradewatch_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Where to start reading", "weight": 1.0}, {"source": "readme_tradewatch", "target": "development_plan_development_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_tradewatch", "target": "docs_pipeline_market_data_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_tradewatch", "target": "docs_backfill_history_and_bars", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_tradewatch", "target": "docs_schema_database_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "architecture_configurable_assumptions", "target": "readme_required_env_vars", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_test_rules", "target": "backend_tests_prov