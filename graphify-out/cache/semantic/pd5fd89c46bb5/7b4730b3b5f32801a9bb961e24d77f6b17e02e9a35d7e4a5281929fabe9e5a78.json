{"nodes": [{"id": "docker_readme_local_stack", "label": "Local Docker Stack", "file_type": "concept", "source_file": "docker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The API and frontend normally run on the host during development because the reload loop is faster and the debugger works; the app profile exists only to check the image itself is correct."}, {"id": "docker_readme_two_advertised_listeners", "label": "Kafka's Two Advertised Listeners", "file_type": "concept", "source_file": "docker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Containers reach the broker as kafka:19092 and the host as 127.0.0.1:9092. A single advertised listener cannot be correct for both \u2014 a client connects, fetches metadata, and then times out talking to an address it cannot route to. The setting most likely to waste an afternoon."}, {"id": "docker_readme_topic_auto_creation_off", "label": "Topic Auto-Creation Is Off", "file_type": "rationale", "source_file": "docker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A topic created implicitly by whoever connected first gets one partition \u2014 one consumer forever \u2014 and infinite retention, which contradicts Kafka being a transport rather than the system of record. The workers create topics deliberately at startup instead."}, {"id": "docker_readme_redis_persistence_off", "label": "Redis Runs With Persistence Off", "file_type": "rationale", "source_file": "docker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redis is a cache and a fan-out bus, never the system of record; starting it without persistence means that assumption is exercised on every restart rather than merely asserted in a document."}, {"id": "docker_readme_kafka_cli_recipes", "label": "Kafka Command-Line Recipes", "file_type": "concept", "source_file": "docker/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading the dead-letter topic with a console consumer is a bigger advantage during development than is usually admitted \u2014 and the reason JSON was chosen over Avro."}], "edges": [{"source": "architecture_database_is_system_of_record", "target": "docker_readme_topic_auto_creation_off", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker/README.md", "source_location": null, "weight": 1.0}, {"source": "architecture_redis_justified_scope", "target": "docker_readme_redis_persistence_off", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker/README.md", "source_location": null, "weight": 1.0}, {"source": "docker_readme_local_stack", "target": "docker_docker_compose_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker/README.md", "source_location": null, "weight": 1.0}, {"source": "docker_readme_local_stack", "target": "docker_docker_compose_redis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker/README.md", "source_location": null, "weight": 1.0}, {"source": "docker_readme_local_stack", "target": "docker_docker_compose_kafka", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker/README.md", "source_location": null, "weight": 1.0}, {"source": "docker_readme_local_stack", "target": "docker_docker_compose_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker/README.md", "source_location": null, "weight": 1.0}, {"source": "docker_readme_two_advertised_listeners", "target": "docker_docker_compose_kafka", "relati